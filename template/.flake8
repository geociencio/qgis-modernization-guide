[flake8]
# QGIS portal-compatible style gate. Flake8 does not read pyproject.toml.
max-line-length = 100
max-complexity = 15

exclude =
    .git,
    __pycache__,
    .venv,
    build,
    dist,
    tests,
    docs,
    examples,
    .eggs,
    *.egg-info

ignore =
    E203,
    W503,
    E501

per-file-ignores =
    __init__.py:F401,F403
    resources/resources.py:E501
